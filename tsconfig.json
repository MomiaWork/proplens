{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "tools/**/*.ts"],
  "exclude": ["node_modules", "ios", "android", ".expo"]
}
